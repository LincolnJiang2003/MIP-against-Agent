# Hugging Face read token from an account with access to gated Meta Llama 3.2 models.
HF_TOKEN=

# Private, persistent Hugging Face state and cache root. Fresh model downloads
# are stored under $HF_HOME/hub; choose a filesystem with sufficient capacity.
HF_HOME=/path/to/persistent/huggingface

# Optional: point this at an existing Hugging Face hub cache. This is useful for
# legacy caches whose model directories live directly in the cache root.
# HF_HUB_CACHE=/path/to/existing/hub-cache
